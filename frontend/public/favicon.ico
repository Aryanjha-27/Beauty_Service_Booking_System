      <stop offset="100%" stop-color="#FFD700" />
    </linearGradient>
  </defs>
  <rect width="512" height="512" rx="128" fill="url(#glowGrad)" />
  <!-- Central Sparkle / Beauty Star -->
  <path d="M 256 96 C 256 184 288 216 376 216 C 288 216 256 248 256 336 C 256 248 224 216 136 216 C 224 216 256 184 256 96 Z" fill="url(#sparkleGrad)" />
